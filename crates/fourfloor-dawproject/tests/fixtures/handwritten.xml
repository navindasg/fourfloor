<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Written by hand against Project.xsd for fourfloor's import tests.
     A group with one child, an effect return fed by a send, a foreign
     built-in device, an automated volume, a looped note clip, markers, a
     3/4 time signature and an expression lane fourfloor cannot hold. -->
<Project version="1.0">
  <Application name="Hand Written" version="0.1"/>
  <Transport>
    <Tempo max="999" min="20" unit="bpm" value="122.5" id="tempo" name="Tempo"/>
    <TimeSignature denominator="4" numerator="3" id="sig"/>
  </Transport>
  <Structure>
    <Track contentType="tracks" loaded="true" id="grp" name="Drums">
      <Channel audioChannels="2" destination="mst" role="submix" solo="false" id="grpch">
        <Mute value="false" id="grpmute" name="Mute"/>
        <Pan max="1" min="0" unit="normalized" value="0.5" id="grppan" name="Pan"/>
        <Volume max="2" min="0" unit="linear" value="0.5" id="grpvol" name="Volume"/>
      </Channel>
      <Track contentType="notes" loaded="true" id="kick" name="Kick">
        <Channel audioChannels="2" destination="grpch" role="regular" solo="false" id="kickch">
          <Devices>
            <Equalizer deviceName="EQ+" deviceRole="audioFX" id="eq" name="Kick EQ">
              <Enabled value="false" id="eqon" name="On/Off"/>
              <Band type="highPass" order="2">
                <Freq max="20000" min="20" unit="hertz" value="40" id="eqf" name="Freq"/>
              </Band>
            </Equalizer>
          </Devices>
          <Mute value="true" id="kickmute" name="Mute"/>
          <Pan max="1" min="0" unit="normalized" value="0.25" id="kickpan" name="Pan"/>
          <Sends>
            <Send destination="fxch" type="pre" id="kicksend">
              <Volume max="2" min="0" unit="linear" value="0.25" id="kicksendvol" name="Send"/>
            </Send>
          </Sends>
          <Volume max="2" min="0" unit="linear" value="1" id="kickvol" name="Volume"/>
        </Channel>
      </Track>
    </Track>
    <Track contentType="audio" loaded="true" id="fx" name="Echo Return">
      <Channel audioChannels="2" destination="mst" role="effect" solo="false" id="fxch">
        <Volume max="2" min="0" unit="linear" value="1" id="fxvol" name="Volume"/>
      </Channel>
    </Track>
    <Track contentType="audio notes" loaded="true" id="master" name="Master">
      <Channel audioChannels="2" role="master" solo="false" id="mst">
        <Volume max="2" min="0" unit="linear" value="1" id="mstvol" name="Volume"/>
      </Channel>
    </Track>
  </Structure>
  <Arrangement id="arr">
    <Lanes timeUnit="beats" id="lanes">
      <Lanes track="kick" id="kicklanes">
        <Clips id="kickclips">
          <Clip time="4" duration="6" playStart="0" loopStart="0" loopEnd="2" name="Kick Loop">
            <Notes id="kicknotes">
              <Note time="0" duration="0.25" channel="0" key="36" vel="1" rel="0.5"/>
              <Note time="1" duration="0.25" channel="0" key="36" vel="0.5" rel="0.5"/>
            </Notes>
          </Clip>
        </Clips>
        <Points id="kickvolauto" unit="linear">
          <Target parameter="kickvol"/>
          <RealPoint time="0" value="1" interpolation="linear"/>
          <RealPoint time="8" value="0.5" interpolation="linear"/>
        </Points>
        <Points id="kickpressure">
          <Target expression="channelPressure" channel="0"/>
          <RealPoint time="0" value="0.5" interpolation="linear"/>
        </Points>
      </Lanes>
    </Lanes>
    <Markers id="markers">
      <Marker time="0" name="Intro"/>
      <Marker time="16" name="Drop"/>
    </Markers>
  </Arrangement>
  <Scenes/>
</Project>
